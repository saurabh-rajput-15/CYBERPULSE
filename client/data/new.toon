      descriptions[1]{lang,value}:
        en,"The line printer daemon (lpd) in the lpr package in multiple Linux operating systems allows local users to gain root privileges by causing sendmail to execute with arbitrary command line arguments, as demonstrated using the -C option to specify a configuration file."
      affected[1]:
        - source: cve@mitre.org
          affectedData[1]:
            - vendor: n/a
              product: n/a
              versions[1]{version,status}:
